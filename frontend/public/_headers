# Cloudflare Pages response headers. Vite copies this file from public/ into dist/.

# Vite puts a content hash in every built file's name, so a changed file always gets a new URL.
# Browsers and the CDN can keep these files for a year without checking for updates.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself must be checked on every visit, so a new deploy loads right away.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
